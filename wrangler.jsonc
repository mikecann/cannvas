{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cannvas",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Cutover verified on 14 October 2026. Keep the old phone links working.
  "vars": { "INVENTORY_ORIGIN": "https://inventory.mikecann.app" },
  "routes": [
    {
      "pattern": "cannvas.mikecann.app",
      "custom_domain": true
    }
  ],
  // Built by `pnpm build:public`. Never point this at ./dist, which is the
  // kiosk build and contains the device token.
  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  }
}
