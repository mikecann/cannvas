# Created by `npx convex dev` for local development.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Inventory authentication and AI enrichment are configured as Convex deployment
# variables, not Vite values. See README.md for the setup commands.

# Kiosk only. Must match CANNVAS_DEVICE_TOKEN in the Convex environment.
# Without it the touchscreen runs on local data with no Convex backup.
# Only the kiosk build (pnpm build / build:mirror) uses it. The public site
# (pnpm build:public) refuses to build if this value would end up in it.
# VITE_CANNVAS_DEVICE_TOKEN=replace-with-a-long-random-value

# Optional. The real kiosk default is five minutes.
# VITE_IDLE_TIMEOUT_MS=300000
