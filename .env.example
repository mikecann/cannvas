# Created by `npx convex dev` for local development.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Inventory authentication and AI enrichment are configured as Convex deployment
# variables, not Vite values. See README.md for the setup commands.

# Must match CALENDAR_ACCESS_TOKEN in the Convex environment. The private
# Google Calendar iCal address itself stays server-side in Convex.
# VITE_CALENDAR_ACCESS_TOKEN=replace-with-a-long-random-value

# Optional. The real kiosk default is five minutes.
# VITE_IDLE_TIMEOUT_MS=300000
