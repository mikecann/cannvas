{
  "name": "cannvas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --config vite.public.config.ts",
    "build:mirror": "VITE_CONVEX_URL=https://resolute-dalmatian-719.convex.cloud VITE_CONVEX_SITE_URL=https://resolute-dalmatian-719.convex.site pnpm build",
    "preview": "vite preview --host 0.0.0.0",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy:cloudflare": "wrangler deploy",
    "preview:public": "vite preview --config vite.public.config.ts --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs deploy/*.test.mjs && python3 -m unittest deploy/cannvas_server_test.py",
    "test:server": "python3 -m unittest deploy/cannvas_server_test.py",
    "test:media": "node --test deploy/*.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.27",
    "@ai-sdk/provider-utils": "4.0.14",
    "@auth/core": "0.41.3",
    "@convex-dev/agent": "0.6.4",
    "@convex-dev/auth": "0.0.94",
    "@vitejs/plugin-react": "6.0.5",
    "ai": "6.0.76",
    "convex": "1.42.3",
    "convex-helpers": "0.1.120",
    "fluent-convex": "^0.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "1.28.0",
    "node-ical": "^0.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.2",
    "wrangler": "4.118.0"
  }
}
