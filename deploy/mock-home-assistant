#!/usr/bin/env python3
"""A pretend Home Assistant for trying Cannvas on a laptop. Development only.

It serves made-up states for the devices Cannvas shows, a drawn vacuum map and
front door picture, and accepts actions by changing its own pretend states, so
nothing real ever moves or switches. deploy.sh never ships this file.

    deploy/mock-home-assistant [--port 8124] [--no-camera]

Point a local cannvas-server at it with a config file such as
{"url": "http://127.0.0.1:8124", "token": "mock-token-0000000000"}. Then:

    curl -X POST localhost:8124/mock/ding      ring the doorbell
    curl -X POST localhost:8124/mock/motion    motion at the front door
    curl -X POST localhost:8124/mock/state -d '{"entity_id": "vacuum.roborock_q7_max", "state": "error"}'

--no-camera makes the front door camera fail the way Ring does without a
Ring Protect plan.
"""

from __future__ import annotations

import argparse
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from threading import Lock
import struct
from typing import Any
import zlib


def now(offset_minutes: float = 0) -> str:
    return (datetime.now(timezone.utc) + timedelta(minutes=offset_minutes)).isoformat()


def entity(entity_id: str, state: str, name: str, **attributes: Any) -> dict[str, Any]:
    return {
        "entity_id": entity_id,
        "state": state,
        "attributes": {"friendly_name": name, **attributes},
        "last_changed": now(-90),
        "last_updated": now(-90),
    }


VACUUM = "roborock_q7_max"


