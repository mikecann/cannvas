def system_prompt(devices: list[Device]) -> str:
    names = ", ".join(device.name for device in devices) or "none"
    apps = ", ".join(APPS)
    return (
        "You are Cannvas, the Cann family's wall display in Busselton, Western Australia. "
        "You hear one spoken request at a time, transcribed by speech recognition, so expect small mistakes. "
        "Use a tool whenever the request is about the devices or the screen, and never say you did something without calling its tool. "
        "Otherwise answer in one short, friendly sentence that sounds natural spoken aloud: no lists, no markdown, no emoji. "
        f"Devices you can switch: {names}. 'Lights' on their own means all lights. "
        f"Screens you can open: {apps}. "
        "If you are not sure what they meant, ask a short question."
    )


def tools(devices: list[Device]) -> list[dict[str, Any]]:
    return [
        {
            "type": "function",
            "function": {
                "name": "control_devices",
                "description": "Turn lights or switches on or off, or set a light's brightness.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "targets": {
                            "type": "array",
                            "items": {"type": "string", "enum": [ALL_LIGHTS, *[device.name for device in devices]]},
                            "description": "Which devices.",
                        },
                        "action": {"type": "string", "enum": ["on", "off"]},
                        "brightness_pct": {"type": "integer", "minimum": 1, "maximum": 100, "description": "Only when they ask for a brightness."},
                    },
                    "required": ["targets", "action"],
                },
            },
        },
        {
            "type": "function",
            "function": {
                "name": "open_app",
                "description": "Show one of Cannvas's screens.",
                "parameters": {
                    "type": "object",
                    "properties": {"app": {"type": "string", "enum": list(APPS)}},
                    "required": ["app"],
                },
            },
        },
    ]


def spoken_context(now: datetime) -> str:
    return f"(It is {now.strftime('%A %-d %B, %-I:%M %p').replace('AM', 'am').replace('PM', 'pm')}.)"


def clean_reply(text: str) -> str:
    """One or two plain sentences, safe to speak."""
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.S)
    text = re.sub(r"[*_#`>\[\]]", "", text)
    text = re.sub(r"[\U0001F000-\U0001FFFF☀-➿]", "", text)
    text = " ".join(text.split())
    sentences = re.split(r"(?<=[.!?])\s+", text)
    return " ".join(sentences[:2]).strip()


def list_names(names: list[str]) -> str:
    return names[0] if len(names) == 1 else f"{', '.join(names[:-1])} and {names[-1]}"


@dataclass
class Outcome:
    reply: str
    commands: list[dict[str, Any]] = field(default_factory=list)


class Agent:
    def __init__(
        self,
        llm_url: str = LLM_URL,
        ha_loader: Callable[[], dict[str, str] | None] = load_home_assistant,
        cloud_url: str = OPENROUTER_URL,
        key_loader: Callable[[], str | None] = load_openrouter_key,
    ) -> None:
        self.llm_url = llm_url
        self.ha_loader = ha_loader
        self.cloud_url = cloud_url
        self.key_loader = key_loader
        self.devices: list[Device] = []
        self.devices_at = 0.0
        self.history: list[dict[str, Any]] = []
        self.history_at = 0.0

    def refresh_devices(self, force: bool = False) -> None:
        if not force and time.monotonic() - self.devices_at < 300:
            return
        config = self.ha_loader()
        if not config:
            return
        try:
            self.devices = voice_devices(home_assistant(config, "/api/states") or [], load_extra_devices())
            self.devices_at = time.monotonic()
        except (HTTPError, URLError, TimeoutError, ValueError) as error:
            log(f"could not load devices: {error}")

    def chat(self, messages: list[dict[str, Any]]) -> dict[str, Any]:
        if key := self.key_loader():
            try:
                return self.complete(f"{self.cloud_url}/v1/chat/completions", {
                    "model": CLOUD_MODEL,
                    "messages": messages,
                    "tools": tools(self.devices),
                    "max_tokens": 300,
                    # A spoken request needs a quick answer more than a careful one.
                    "reasoning": {"effort": "none"},
                }, {"Authorization": f"Bearer {key}", "X-Title": "Cannvas"}, timeout=10)
            except (HTTPError, URLError, TimeoutError, KeyError, IndexError, ValueError, OSError) as error:
                log(f"OpenRouter failed, so the local model will answer: {error}")
        return self.local(messages)

    def local(self, messages: list[dict[str, Any]], max_tokens: int = 160) -> dict[str, Any]:
        # The system prompt and tools must stay byte-for-byte the same between
        # requests. llama-server then reuses them from its cache instead of
        # spending about 25 seconds reading them again on the Pi.
        return self.complete(f"{self.llm_url}/v1/chat/completions", {
            "messages": messages,
            "tools": tools(self.devices),
            "temperature": 0.2,
            "max_tokens": max_tokens,
            "cache_prompt": True,
            # Qwen3-style models think out loud unless told not to.
            "chat_template_kwargs": {"enable_thinking": False},
        }, {}, timeout=45)

    def complete(self, url: str, body: dict[str, Any], headers: dict[str, str], timeout: float) -> dict[str, Any]:
        request = Request(
            url,
            data=json.dumps(body).encode("utf-8"),
            headers={"Content-Type": "application/json", **headers},
            method="POST",
        )
        with _OPENER.open(request, timeout=timeout) as response:
            return json.loads(response.read())["choices"][0]["message"]

    def warm(self) -> None:
        """Get the system prompt and tools into the local model's cache before anyone needs it."""
        for _ in range(60):
            try:
                self.local([{"role": "system", "content": system_prompt(self.devices)}, {"role": "user", "content": "Hello."}], max_tokens=1)
                log("local language model is ready")
                return
            except (HTTPError, URLError, TimeoutError, KeyError, ValueError, OSError):
                time.sleep(5)  # llama-server is still loading the model.
        log("local language model did not answer the warm-up")

    def handle(self, heard: str, now: datetime | None = None) -> Outcome:
        self.refresh_devices()
        if time.monotonic() - self.history_at > CONVERSATION_SECONDS:
            self.history = []
        now = now or datetime.now(ZONE)
        user = {"role": "user", "content": f"{spoken_context(now)} {heard}"}
        message = quick_command(heard, self.devices)
        if message is None:
            try:
                message = self.chat([{"role": "system", "content": system_prompt(self.devices)}, *self.history, user])
            except (HTTPError, URLError, TimeoutError, KeyError, IndexError, ValueError, OSError) as error:
                log(f"language model failed: {error}")
                return Outcome("Sorry, my brain isn't answering right now.")
        outcome = self.act(message)
        self.history = [*self.history, user, {"role": "assistant", "content": outcome.reply}][-HISTORY_TURNS * 2:]
        self.history_at = time.monotonic()
        return outcome

    def act(self, message: dict[str, Any]) -> Outcome:
        calls = message.get("tool_calls") or []
        if not calls:
            return Outcome(clean_reply(str(message.get("content") or "")) or "Sorry, I didn't catch that.")
        replies: list[str] = []
        commands: list[dict[str, Any]] = []
        for call in calls:
            function = call.get("function") or {}
            try:
                arguments = json.loads(function.get("arguments") or "{}")
            except json.JSONDecodeError:
                arguments = {}
            if not isinstance(arguments, dict):
                arguments = {}
            name = function.get("name")
            if name == "control_devices":
                replies.append(self.control(arguments))
            elif name == "open_app":
                app = APPS.get(str(arguments.get("app", "")).lower())
                if app:
                    commands.append({"name": "open_app", "app": app})
                    replies.append(f"Here's {APP_NAMES.get(app, 'the ' + app)}.")
                else:
                    replies.append("I don't have that screen.")
        return Outcome(" ".join(replies) or "Sorry, I didn't catch that.", commands)

    def control(self, arguments: dict[str, Any]) -> str:
        targets = arguments.get("targets")
        targets = [targets] if isinstance(targets, str) else targets if isinstance(targets, list) else []
        action = arguments.get("action")
        if action not in {"on", "off"}:
            return "Sorry, should that be on or off?"
        devices = resolve_targets(targets, self.devices)
        if not devices:
            return "Sorry, I don't know which light you mean."
        config = self.ha_loader()
        if not config:
            return "Home Assistant isn't connected yet."
        # Small models sometimes send the number as a string.
        brightness = arguments.get("brightness_pct")
        try:
            brightness = max(1, min(100, round(float(brightness)))) if brightness is not None and action == "on" else None
        except (TypeError, ValueError):
            brightness = None
        done: list[str] = []
        failed: list[str] = []
        for device in devices:
            payload: dict[str, Any] = {"entity_id": device.entity_id}
            if brightness is not None and device.domain == "light":
                payload["brightness_pct"] = brightness
            try:
                home_assistant(config, f"/api/services/{device.domain}/turn_{action}", payload)
                done.append(device.name)
            except (HTTPError, URLError, TimeoutError, ValueError) as error:
                log(f"{device.entity_id} turn_{action} failed: {error}")
                failed.append(device.name)
        if not done:
            return "Sorry, I couldn't reach Home Assistant."
        everything = len(done) > 1 and len(done) == len([d for d in self.devices if d.domain == "light"])
        what = "the lights" if everything else list_names(done)
        reply = f"{what[0].upper()}{what[1:]} set to {brightness} percent." if brightness else f"Okay, {what} {'are' if len(done) > 1 else 'is'} {action}."
        if failed:
            reply += f" {list_names(failed)} didn't respond."
        return reply


# Wake word training ---------------------------------------------------------


def training_choice(value: dict[str, Any]) -> dict[str, str]:
    """Who is speaking, where, and whether they will say the wake word. Raises ValueError."""
    choice = {key: str(value.get(key, "")) for key in TRAINING_CHOICES}
    for key, allowed in TRAINING_CHOICES.items():
        if choice[key] not in allowed:
            raise ValueError(f"Choose a {key}")
    return choice


class Utterances:
    """Splits the microphone into utterances while recording training samples.

    Frames are opaque here. Each finished utterance comes back with a little
    audio from before it started and the best wake word score heard during it.
    """

    def __init__(self) -> None:
        # The frame where speech starts and 0.56 s before it.
        self.before: deque[Any] = deque(maxlen=8)
        self.frames: list[Any] | None = None
        self.silence = 0.0
        self.best = 0.0

    def feed(self, frame: Any, score: float, speech: float) -> tuple[list[Any], float] | None:
        if self.frames is None:
            self.before.append(frame)
            if speech >= SPEECH_START:
                self.frames, self.silence, self.best = list(self.before), 0.0, score
            return None
        self.frames.append(frame)
        self.best = max(self.best, score)
        if speech >= SPEECH_START:
            self.silence = 0.0
        elif speech < SPEECH_END:
            self.silence += FRAME / SAMPLE_RATE
        if self.silence < UTTERANCE_END_SILENCE and len(self.frames) * FRAME / SAMPLE_RATE < UTTERANCE_MAX:
            return None
        finished = (self.frames, self.best)
        self.frames = None
        self.before.clear()
        return finished


class SampleStore:
    """Training samples on the Pi: a 16 kHz WAV and a JSON description each."""

    def __init__(self, root: Path = SAMPLES_DIR) -> None:
        self.root = root

    def save(self, pcm: bytes, info: dict[str, Any]) -> dict[str, Any]:
        self.root.mkdir(mode=0o700, parents=True, exist_ok=True)
        sample_id = f"{datetime.now(ZONE):%Y%m%d-%H%M%S}-{info['speaker']}-{secrets.token_hex(2)}"
        with wave.open(str(self.root / f"{sample_id}.wav"), "wb") as audio:
            audio.setnchannels(1)
            audio.setsampwidth(2)
            audio.setframerate(SAMPLE_RATE)
            audio.writeframes(pcm)
        sample = {"id": sample_id, **info}
        (self.root / f"{sample_id}.json").write_text(json.dumps(sample), encoding="utf-8")
        return sample

    def list(self) -> list[dict[str, Any]]:
        samples = []
        for path in sorted(self.root.glob("*.json"), reverse=True):
            try:
                samples.append(json.loads(path.read_text(encoding="utf-8")))
            except (json.JSONDecodeError, OSError):
                continue
        return samples

    def delete(self, sample_id: str) -> bool:
        if not SAMPLE_ID.fullmatch(sample_id):
            return False
        found = False
        for suffix in (".wav", ".json"):
            path = self.root / f"{sample_id}{suffix}"
            if path.exists():
                path.unlink()
                found = True
        return found


# Events for the kiosk -------------------------------------------------------


class Events:
    """Fans voice activity out to every connected page."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.clients: list[queue.Queue[dict[str, Any]]] = []
        # The latest of each of these is replayed to a page when it connects.
        self.latest: dict[str, dict[str, Any]] = {
            "state": {"type": "state", "phase": "idle", "heard": "", "reply": ""},
            "training": {"type": "training", "active": False},
        }

    def subscribe(self) -> queue.Queue[dict[str, Any]]:
        client: queue.Queue[dict[str, Any]] = queue.Queue(maxsize=100)
        with self.lock:
            for event in self.latest.values():
                client.put(dict(event))
            self.clients.append(client)
        return client

    def unsubscribe(self, client: queue.Queue[dict[str, Any]]) -> None:
        with self.lock:
            if client in self.clients:
                self.clients.remove(client)

    def publish(self, event: dict[str, Any]) -> None:
        with self.lock:
            if event.get("type") in self.latest:
                self.latest[event["type"]] = dict(event)
            for client in self.clients:
                try:
                    client.put_nowait(event)
                except queue.Full:
                    pass  # A stalled page misses level updates, never the server.

    def phase(self, phase: str, heard: str = "", reply: str = "") -> None:
        self.publish({"type": "state", "phase": phase, "heard": heard, "reply": reply})


# Speech ---------------------------------------------------------------------


def chime(np: Any, rising: bool = True) -> bytes:
    """A short two-note chime as 16 kHz mono PCM."""
    notes = (880, 1320) if rising else (1320, 880)
    parts = []
    for frequency in notes:
        t = np.arange(int(SAMPLE_RATE * 0.09)) / SAMPLE_RATE
        envelope = np.minimum(1, np.minimum(t * 200, (t[-1] - t) * 60))
        parts.append(0.22 * envelope * np.sin(2 * np.pi * frequency * t))
    return (np.concatenate(parts) * 32767).astype(np.int16).tobytes()


def play(pcm: bytes, rate: int) -> subprocess.Popen[bytes]:
    player = subprocess.Popen(
        ["pw-play", "--rate", str(rate), "--channels", "1", "--format", "s16", "-"],
        stdin=subprocess.PIPE,
    )
    assert player.stdin
    player.stdin.write(pcm)
    player.stdin.close()
    return player


def load_speech_model(path: Path) -> Any:
    import sherpa_onnx

    # Detect the exported files, so CANNVAS_SPEECH_MODEL can also select a
    # Moonshine rollback or a model stored outside the install directory.
    if all((path / name).is_file() for name in (
        "encoder.int8.onnx", "decoder.int8.onnx", "joiner.int8.onnx", "tokens.txt",
    )):
        # Same three-thread, default greedy decoder as stt-bakeoff/run_model.py's
        # parakeet-unified run. Hotwords added about 0.7 s for little gain.
        speech = sherpa_onnx.OfflineRecognizer.from_transducer(
            encoder=str(path / "encoder.int8.onnx"),
            decoder=str(path / "decoder.int8.onnx"),
            joiner=str(path / "joiner.int8.onnx"),
            tokens=str(path / "tokens.txt"),
            model_type="nemo_transducer",
            num_threads=3,
        )
        engine = "Parakeet Unified"
    elif all((path / name).is_file() for name in (
        "preprocess.onnx", "encode.int8.onnx", "uncached_decode.int8.onnx",
        "cached_decode.int8.onnx", "tokens.txt",
    )):
        speech = sherpa_onnx.OfflineRecognizer.from_moonshine(
            preprocessor=str(path / "preprocess.onnx"),
            encoder=str(path / "encode.int8.onnx"),
            uncached_decoder=str(path / "uncached_decode.int8.onnx"),
            cached_decoder=str(path / "cached_decode.int8.onnx"),
            tokens=str(path / "tokens.txt"),
            num_threads=3,
        )
        engine = "Moonshine"
    else:
        raise ValueError(f"No complete Parakeet or Moonshine speech model in {path}")
    log(f"loaded {engine} speech model from {path}")
    return speech


def wake_command(heard: str) -> str | None:
    """The words after a leading wake phrase, empty for just a wake, or None.

    Parakeet sometimes drops "hey" or spells the name "Cannvas". Match whole
    words at the start only: "a canvas" and "hey can you" aren't addressing us.
    "Canvas" on its own is allowed only after the low wake-score gate.
    """
    match = re.match(r"^\W*(?:hey\W+)?(?:canvas|cannvas)\b\W*", heard, flags=re.I)
    return heard[match.end():].strip() if match else None


class Voice:
    """Microphone in, speaker out, and the listening state machine between them."""

    def __init__(self, agent: Agent, events: Events, samples: SampleStore) -> None:
        import numpy as np
        from openwakeword.model import Model as WakeModel
        from openwakeword.vad import VAD
        from piper import PiperVoice

        self.np = np
        self.agent = agent
        self.events = events
        self.samples = samples
        self.wake = WakeModel(wakeword_models=[WAKE_WORD], inference_framework="onnx")
        self.vad = VAD()
        self.speech = load_speech_model(SPEECH_MODEL)
        # Training saves can still be finishing when normal listening resumes.
        # Share the resident recognizer rather than decoding concurrently.
        self.speech_lock = threading.Lock()
        self.piper = PiperVoice.load(PIPER_VOICE)
        self.start_chime = chime(np)
        self.end_chime = chime(np, rising=False)
        self.lock = threading.Lock()
        self.listen_requested = threading.Event()
        self.player: subprocess.Popen[bytes] | None = None
        self.busy = False
        self.deaf_until = 0.0
        # Who is recording wake word samples, or None when voice works normally.
        self.training: dict[str, Any] | None = None
        self.utterances = Utterances()
        self.idle_utterances = Utterances()
        # Set when recording stops. The listening thread then starts afresh.
        self.resume_listening = False

    # Called from the HTTP server.
    def request_listen(self) -> None:
        self.listen_requested.set()

    def cancel(self) -> None:
        with self.lock:
            if self.player and self.player.poll() is None:
                self.player.terminate()

    def start_training(self, choice: dict[str, str]) -> None:
        with self.lock:
            ends_at = time.time() + TRAINING_SECONDS
            # A new recording starts clean in the listening thread, so nothing
            # heard before can count towards a sample.
            fresh = self.training is None or self.training.get("fresh", False)
            self.training = {**choice, "until": time.monotonic() + TRAINING_SECONDS, "fresh": fresh}
        self.events.publish({"type": "training", "active": True, **choice, "endsAt": round(ends_at * 1000)})
        log(f"recording wake word samples: {choice}")

    def stop_training(self) -> None:
        with self.lock:
            if self.training is None:
                return
            self.training = None
            self.resume_listening = True
        self.events.publish({"type": "training", "active": False})
        log("stopped recording wake word samples")

    def microphone(self) -> subprocess.Popen[bytes]:
        return subprocess.Popen(
            ["pw-record", "--rate", str(SAMPLE_RATE), "--channels", "1", "--format", "s16", "--latency", "40ms", *MIC_ARGS, "-"],
            stdout=subprocess.PIPE,
        )

    def run(self) -> None:
        while True:
            recorder = self.microphone()
            try:
                self.listen(recorder)
            finally:
                recorder.terminate()
            log("microphone stopped; restarting")
            time.sleep(2)

    def boosted(self, frame: Any) -> Any:
        np = self.np
        return np.clip(frame.astype(np.int32) * MIC_GAIN, -32768, 32767).astype(np.int16)

    def listen(self, recorder: subprocess.Popen[bytes]) -> None:
        np = self.np
        assert recorder.stdout
        command: list[Any] | None = None
        speech: list[int] = []  # Frames the VAD thinks are speech.
        silence = 0.0
        started = 0.0
        last_level = 0.0
        last_near_miss = 0.0
        while True:
            raw = recorder.stdout.read(FRAME * 2)
            if len(raw) < FRAME * 2:
                return
            heard = np.frombuffer(raw, dtype=np.int16)
            frame = self.boosted(heard)
            if self.busy:
                continue
            if training := self.training:
                if training.pop("fresh", False):
                    self.wake.reset()
                    self.vad.reset_states()
                    self.utterances = Utterances()
                if time.monotonic() >= training["until"]:
                    self.stop_training()
                else:
                    self.record_sample(heard, frame, training)
                continue
            if self.resume_listening:
                self.resume_listening = False
                self.rest()
            if command is None:
                score = max(self.wake.predict(frame).values(), default=0)
                if NEAR_MISS <= score < WAKE_THRESHOLD and time.monotonic() - last_near_miss > 1.5:
                    last_near_miss = time.monotonic()
                    log(f"wake word near miss {score:.2f}")
                manual = self.listen_requested.is_set()
                if manual or (score >= WAKE_THRESHOLD and time.monotonic() >= self.deaf_until):
                    self.listen_requested.clear()
                    log(f"listening ({'button' if manual else f'wake word {score:.2f}'})")
                    command, speech, silence, started = [], [], 0.0, time.monotonic()
                    # This utterance now belongs entirely to the normal path.
                    self.idle_utterances = Utterances()
                    self.vad.reset_states()
                    self.events.phase("listening")
                    play(self.start_chime, SAMPLE_RATE)
                elif SECOND_CHANCE > 0:
                    self.check_idle_frame(frame, score)
                continue
            command.append(frame)
            probability = float(self.vad.predict(frame, frame_size=640))
            if time.monotonic() - last_level > 0.1:
                last_level = time.monotonic()
                rms = float(np.sqrt(np.mean((frame.astype(np.float32) / 32768) ** 2)))
                self.events.publish({"type": "level", "value": round(min(1.0, rms * 8), 3)})
            if probability >= SPEECH_START:
                speech.append(len(command) - 1)
                silence = 0.0
            elif probability < SPEECH_END:
                silence += FRAME / SAMPLE_RATE
            elapsed = time.monotonic() - started
            done = (speech and silence >= END_SILENCE) or elapsed >= MAX_COMMAND
            if not speech and elapsed >= NO_SPEECH_TIMEOUT:
                log("heard nothing after the wake word")
                command = None
                self.events.phase("idle")
                self.rest()
            elif done:
                # Moonshine copes badly with long silences, so drop most of
                # them. Keep 0.6 s before the first frame the VAD called speech:
                # the mic's automatic gain is still recovering from the chime
                # then, so the VAD can miss the first word.
                audio = np.concatenate(command[max(0, speech[0] - 8):speech[-1] + 4])
                command = None
                self.busy = True
                play(self.end_chime, SAMPLE_RATE)
                threading.Thread(target=self.respond, args=(audio,), daemon=True).start()

    def check_idle_frame(self, frame: Any, score: float) -> None:
        """Keep one bounded utterance, then check its low-band wake score."""
        if (not 0 < SECOND_CHANCE < WAKE_THRESHOLD or self.busy or self.training
                or self.resume_listening or time.monotonic() < self.deaf_until):
            self.idle_utterances = Utterances()
            return
        probability = float(self.vad.predict(frame, frame_size=640))
        finished = self.idle_utterances.feed(frame, score, probability)
        if finished is None:
            return
        frames, best = finished
        if not SECOND_CHANCE <= best < WAKE_THRESHOLD:
            return
        self.idle_utterances = Utterances()
        # Drain the microphone while decoding, just as for a normal request.
        # No second model, queued room speech or concurrent response is needed.
        self.busy = True
        audio = self.np.concatenate(frames)
        threading.Thread(target=self.check_second_chance, args=(audio, best), daemon=True).start()

    def check_second_chance(self, audio: Any, score: float) -> None:
        answering = False
        try:
            heard = self.transcribe(audio)
            # Training may have started (and even stopped) during decoding.
            if self.training or self.resume_listening or time.monotonic() < self.deaf_until:
                return
            command = wake_command(heard)
            if command is None:
                log(f"wake second chance rejected {score:.2f}")
                return
            log(f"wake second chance accepted {score:.2f}: {heard!r}")
            if not command:
                # The listening thread owns the normal chime and command VAD.
                self.listen_requested.set()
                return
            play(self.end_chime, SAMPLE_RATE)
            answering = True
            self.respond(audio, heard=command)
        except Exception:  # Rejected room speech must never reach logs or SSE.
            log(f"wake second chance failed {score:.2f}")
        finally:
            if not answering:
                self.rest()
                self.busy = False

    def record_sample(self, heard: Any, frame: Any, training: dict[str, Any]) -> None:
        """Score the wake word as usual but act on nothing, and keep each utterance."""
        score = max(self.wake.predict(frame).values(), default=0)
        speech = float(self.vad.predict(frame, frame_size=640))
        # Keep what the mic heard, before the service's boost, for training.
        if finished := self.utterances.feed(heard, score, speech):
            frames, best = finished
            threading.Thread(target=self.keep_sample, args=(self.np.concatenate(frames), best, training), daemon=True).start()

    def keep_sample(self, audio: Any, score: float, training: dict[str, Any]) -> None:
        try:
            sample = self.samples.save(audio.tobytes(), {
                "at": datetime.now(ZONE).isoformat(timespec="seconds"),
                **{key: training[key] for key in TRAINING_CHOICES},
                "score": round(float(score), 3),
                "wouldWake": bool(score >= WAKE_THRESHOLD),
                "heard": self.transcribe(audio),
                "seconds": round(len(audio) / SAMPLE_RATE, 1),
            })
            log(f"sample {sample['id']}: score {sample['score']}, heard {sample['heard']!r}")
            self.events.publish({"type": "sample", "sample": sample})
        except Exception as error:  # A failed save must never stop the listener.
            log(f"could not keep a sample: {error!r}")

    def rest(self) -> None:
        # Ignore the wake word briefly so the chime or reply can't retrigger it.
        self.wake.reset()
        self.vad.reset_states()
        self.idle_utterances = Utterances()
        self.deaf_until = time.monotonic() + 1.0

    def transcribe(self, audio: Any) -> str:
        np = self.np
        samples = audio.astype(np.float32) / 32768
        peak = float(np.max(np.abs(samples))) or 1.0
        with self.speech_lock:
            stream = self.speech.create_stream()
            stream.accept_waveform(SAMPLE_RATE, samples * (0.7 / peak))
            self.speech.decode_stream(stream)
            return stream.result.text.strip()

    def speak(self, text: str) -> None:
        np = self.np
        chunks = list(self.piper.synthesize(text))
        if not chunks:
            return
        pcm = np.concatenate([chunk.audio_int16_array for chunk in chunks]).tobytes()
        with self.lock:
            self.player = play(pcm, chunks[0].sample_rate)
        self.player.wait()

    def respond(self, audio: Any, *, heard: str | None = None) -> None:
        try:
            started = time.monotonic()
            self.events.phase("thinking")
            heard = self.transcribe(audio) if heard is None else heard
            transcribed = time.monotonic()
            if re.sub(r"[^a-z ]", "", heard.lower()).strip() in PHANTOM_PHRASES:
                log("nothing intelligible")
                self.events.phase("idle")
                return
            self.events.phase("thinking", heard)
            outcome = self.agent.handle(heard)
            answered = time.monotonic()
            for command in outcome.commands:
                self.events.publish({"type": "command", **command})
            self.events.phase("speaking", heard, outcome.reply)
            log(f"heard {heard!r} -> {outcome.reply!r} (speech {transcribed - started:.1f}s, model {answered - transcribed:.1f}s)")
            self.speak(outcome.reply)
            self.events.phase("idle", heard, outcome.reply)
        except Exception as error:  # A bad request must never stop the listener.
            log(f"request failed: {error!r}")
            self.events.phase("idle")
        finally:
            self.rest()
            self.busy = False


# Loopback server ------------------------------------------------------------


class VoiceHandler(BaseHTTPRequestHandler):
    server_version = "CannvasVoice"
    sys_version = ""
    voice: Voice | None = None
    events: Events
    samples: SampleStore

    def allowed(self) -> bool:
        port = self.server.server_address[1]
        if (self.headers.get("Host") or "").lower() not in {f"127.0.0.1:{port}", f"localhost:{port}"} or self.headers.get("Origin"):
            self.send_error(403)
            return False
        return True

    def reply(self, status: int, value: Any) -> None:
        body = json.dumps(value).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def read_json(self) -> dict[str, Any]:
        length = int(self.headers.get("Content-Length") or 0)
        if length > 4096:
            raise ValueError("Request too large")
        value = json.loads(self.rfile.read(length) or b"{}")
        if not isinstance(value, dict):
            raise ValueError("Expected a JSON object")
        return value

    def do_GET(self) -> None:
        if not self.allowed():
            return
        if self.path == "/health":
            self.reply(200, {"ok": True, "ready": self.voice is not None})
        elif self.path == "/events":
            self.stream()
        elif self.path == "/training":
            self.reply(200, {"samples": self.samples.list()})
        else:
            self.reply(404, {"error": "Not found"})

    def do_POST(self) -> None:
        if not self.allowed():
            return
        try:
            body = self.read_json()
        except ValueError as error:
            self.reply(400, {"error": str(error)})
            return
        if self.path == "/training/delete":
            found = self.samples.delete(str(body.get("id", "")))
            self.reply(200 if found else 404, {"ok": found})
        elif self.voice is None:
            self.reply(503, {"error": "Voice is still starting"})
        elif self.path == "/listen":
            self.voice.request_listen()
            self.reply(202, {"ok": True})
        elif self.path == "/cancel":
            self.voice.cancel()
            self.reply(202, {"ok": True})
        elif self.path == "/training/start":
            try:
                self.voice.start_training(training_choice(body))
            except ValueError as error:
                self.reply(400, {"error": str(error)})
                return
            self.reply(202, {"ok": True})
        elif self.path == "/training/stop":
            self.voice.stop_training()
            self.reply(202, {"ok": True})
        else:
            self.reply(404, {"error": "Not found"})

    def stream(self) -> None:
        client = self.events.subscribe()
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(b"retry: 3000\n\n")
            while True:
                try:
                    event = client.get(timeout=15)
                    self.wfile.write(f"data: {json.dumps(event)}\n\n".encode("utf-8"))
                except queue.Empty:
                    self.wfile.write(b": keepalive\n\n")
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, TimeoutError):
            pass
        finally:
            self.events.unsubscribe(client)

    def log_message(self, format: str, *args: object) -> None:
        pass


class VoiceServer(ThreadingHTTPServer):
    daemon_threads = True


def main() -> None:
    events = Events()
    samples = SampleStore()
    VoiceHandler.events = events
    VoiceHandler.samples = samples
    server = VoiceServer((LISTEN_HOST, LISTEN_PORT), VoiceHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    agent = Agent()
    agent.refresh_devices(force=True)
    log(f"{len(agent.devices)} devices: {', '.join(device.name for device in agent.devices)}")
    log(f"questions go to {CLOUD_MODEL} through OpenRouter" if load_openrouter_key() else "no OpenRouter key, so the local model answers questions")
    threading.Thread(target=agent.warm, daemon=True).start()
    voice = Voice(agent, events, samples)
    VoiceHandler.voice = voice
    log(f"ready, listening for {Path(WAKE_WORD).stem}")
    voice.run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
