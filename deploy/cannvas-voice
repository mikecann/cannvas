# Home Assistant -------------------------------------------------------------


def load_home_assistant() -> dict[str, str] | None:
    try:
        value = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    if not isinstance(value, dict):
        return None
    url = str(value.get("url", "")).rstrip("/")
    token = str(value.get("token", ""))
    return {"url": url, "token": token} if url and token else None


def load_openrouter_key() -> str | None:
    try:
        value = json.loads(OPENROUTER_CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    key = str(value.get("apiKey", "")).strip() if isinstance(value, dict) else ""
    return key or None


def home_assistant(config: dict[str, str], path: str, payload: dict[str, Any] | None = None) -> Any:
    request = Request(
        f"{config['url']}{path}",
        data=json.dumps(payload).encode("utf-8") if payload is not None else None,
        headers={"Authorization": f"Bearer {config['token']}", "Content-Type": "application/json"},
        method="POST" if payload is not None else "GET",
    )
    with _OPENER.open(request, timeout=8) as response:
        return json.loads(response.read() or b"null")


# Devices --------------------------------------------------------------------


@dataclass(frozen=True)
class Device:
    entity_id: str
    name: str

    @property
    def domain(self) -> str:
        return self.entity_id.partition(".")[0]


ALL_LIGHTS = "all lights"


def load_extra_devices() -> dict[str, str]:
    try:
        value = json.loads(VOICE_CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}
    devices = value.get("devices") if isinstance(value, dict) else None
    if not isinstance(devices, dict):
        return {}
    return {str(entity): str(name) for entity, name in devices.items() if isinstance(name, str) and name.strip()}


def voice_devices(states: list[dict[str, Any]], extras: dict[str, str]) -> list[Device]:
    """Every light, plus the switches named in voice.json. Never the Pi's own plug."""
    devices: list[Device] = []
    seen: set[str] = set()
    for state in states:
        entity_id = str(state.get("entity_id", ""))
        attributes = state.get("attributes") if isinstance(state.get("attributes"), dict) else {}
        if entity_id in BLOCKED_ENTITIES or entity_id in seen:
            continue
        if entity_id in extras:
            name = extras[entity_id]
        elif entity_id.startswith("light."):
            name = str(attributes.get("friendly_name") or entity_id.partition(".")[2].replace("_", " ").title())
        else:
            continue
        if entity_id.partition(".")[0] not in {"light", "switch", "fan", "input_boolean"}:
            continue
        seen.add(entity_id)
        devices.append(Device(entity_id, name.strip()))
    return devices


def resolve_targets(targets: list[str], devices: list[Device]) -> list[Device]:
    by_name = {device.name.lower(): device for device in devices}
    chosen: list[Device] = []
    for target in targets:
        key = str(target).strip().lower()
        if key in {ALL_LIGHTS, "all", "lights", "the lights"}:
            matches = [device for device in devices if device.domain == "light"]
        elif key in by_name:
            matches = [by_name[key]]
        else:
            # Small models sometimes shorten a name ("top lamp"). Accept a
            # target whose words all appear in exactly one device name.
            words = set(re.findall(r"[a-z0-9]+", key)) - {"the", "lamp", "light", "lights"}
            matches = [device for device in devices if words and words <= set(re.findall(r"[a-z0-9]+", device.name.lower()))]
            if len(matches) != 1:
                matches = []
        for device in matches:
            if device not in chosen:
                chosen.append(device)
    return chosen


# Everyday commands ----------------------------------------------------------

# The model takes several seconds to write a tool call on the Pi, so the
# commands people say most are matched here and answered straight away.
# Anything this doesn't recognise goes to the model.

FILLER = re.compile(r"^(?:(?:hey|ok|okay|or|and|um|uh|so|oh) )*(?:canvas |cannvas )?(?:can you |could you |would you |please )*|(?: for me)?(?: please)?$")
NUMBERS = {"ten": 10, "twenty": 20, "twenty five": 25, "thirty": 30, "forty": 40, "fifty": 50, "half": 50,
           "sixty": 60, "seventy": 70, "seventy five": 75, "eighty": 80, "ninety": 90, "a hundred": 100, "one hundred": 100, "full": 100}
APP_ALIASES = {
    **{name: name for name in APPS},
    "home screen": "home", "todos": "to-dos", "to dos": "to-dos", "to do": "to-dos", "to do list": "to-dos",
    "to do lists": "to-dos", "todo list": "to-dos", "todo lists": "to-dos", "chore": "chores", "joshua's chores": "chores",
    "lights": "home controls", "home control": "home controls", "solar panels": "solar", "sammy": "sammy's tablets",
    "sammy's camera": "sammy cam", "dog cam": "sammy cam",
}


def tool_message(name: str, arguments: dict[str, Any]) -> dict[str, Any]:
    return {"content": "", "tool_calls": [{"type": "function", "function": {"name": name, "arguments": json.dumps(arguments)}}]}


def quick_command(heard: str, devices: list[Device]) -> dict[str, Any] | None:
    """A tool call for an everyday command, or None to ask the model."""
    text = re.sub(r"[^a-z0-9%' ]", " ", heard.lower().replace("-", " "))
    text = FILLER.sub("", " ".join(text.split())).strip()
    if match := re.fullmatch(r"(?:set|dim|turn|put) (?:the )?(.+?) (?:to|at) (\d{1,3}|[a-z ]+?)(?: ?%| percent)?(?: brightness)?", text):
        target, amount = match.groups()
        brightness = int(amount) if amount.isdigit() else NUMBERS.get(amount)
        if brightness and 0 < brightness <= 100 and resolve_targets([target], devices):
            names = [device.name for device in resolve_targets([target], devices)]
            return tool_message("control_devices", {"targets": names, "action": "on", "brightness_pct": brightness})
        return None
    match = (re.fullmatch(r"(?:turn|switch|put) (on|off) (?:the |all )?(.+)", text)
             or re.fullmatch(r"(?:turn|switch|put) (?:the |all )?(.+?) (on|off)", text)
             or re.fullmatch(r"(?:the |all )?(.+?) (on|off)", text))
    if match:
        first, second = match.groups()
        action, target = (first, second) if first in {"on", "off"} else (second, first)
        targets = resolve_targets([part for part in re.split(r" and (?:the )?", target)], devices)
        if targets:
            return tool_message("control_devices", {"targets": [device.name for device in targets], "action": action})
        return None
    if text in {"go home", "go back home", "home"}:
        return tool_message("open_app", {"app": "home"})
    if match := re.fullmatch(r"(?:open(?:ed)?(?: up)?|show me|show|go to|take me to|bring up) (?:the |my )?(.+?)(?: app| screen| page)?", text):
        if app := APP_ALIASES.get(match.group(1)):
            return tool_message("open_app", {"app": app})
    return None


