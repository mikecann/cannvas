<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mikerosoft.cannvas-media</string>
  <!-- macOS ties CannMedia access to this exact Node path. After upgrading
       nvm's Node on Bruce, give the new binary Full Disk Access on Bruce's
       screen, or this hangs reading the drive and Cannvas shows no videos. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bruce/.nvm/versions/node/v24.22.1/bin/node</string>
    <string>/Users/bruce/Library/Application Support/cannvas-media/server.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/bruce/Library/Logs/cannvas-media.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bruce/Library/Logs/cannvas-media-error.log</string>
</dict>
</plist>
