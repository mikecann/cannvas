[Unit]
Description=Cannvas touchscreen web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/cannvas/current
ExecStart=/opt/cannvas/current/cannvas-server
Restart=on-failure
RestartSec=2
StateDirectory=cannvas

# The app only writes its private integration configuration directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cannvas

[Install]
WantedBy=multi-user.target
