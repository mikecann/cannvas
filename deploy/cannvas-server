from urllib.parse import parse_qs, urlencode, urlparse
from urllib.request import HTTPRedirectHandler, HTTPSHandler, HTTPCookieProcessor, Request, build_opener
from zoneinfo import ZoneInfo


CONFIG_PATH = Path(os.environ.get("CANNVAS_HOME_ASSISTANT_CONFIG", "/var/lib/cannvas/home-assistant.json"))
UNIFI_CONFIG_PATH = Path(os.environ.get("CANNVAS_UNIFI_CONFIG", "/var/lib/cannvas/unifi.json"))
INVENTORY_CONFIG_PATH = Path(os.environ.get("CANNVAS_INVENTORY_CONFIG", "/var/lib/cannvas/inventory.json"))
VIDEO_URL = os.environ.get("CANNVAS_VIDEO_URL", "http://bruce.local:6113").rstrip("/")
# Only the web build is served. Releases keep it in www/ next to this script so
# the script, units and other deployment files are never reachable over HTTP.
WEB_ROOT = Path(os.environ.get("CANNVAS_WEB_ROOT") or Path(__file__).resolve().parent / "www")
# The kiosk page pings /api/heartbeat. The watchdog reads this tmpfs file, which
# holds CLOCK_BOOTTIME seconds so NTP clock jumps after boot cannot fake an outage.
HEARTBEAT_PATH = Path(os.environ.get("CANNVAS_HEARTBEAT_PATH", "/run/cannvas/heartbeat"))
LISTEN_HOST = "127.0.0.1"
LISTEN_PORT = int(os.environ.get("CANNVAS_PORT", "4173"))
DEFAULT_URL = "http://homeassistant.local:8123"
ENTITY_ID = re.compile(r"^[a-z_]+\.[a-z0-9_]+$")
ALLOWED_ACTIONS = {
    "turn_on": {"light", "switch", "fan", "input_boolean", "media_player", "scene", "script"},
    "turn_off": {"light", "switch", "fan", "input_boolean", "media_player"},
}
_UNIFI_LOCK = Lock()
_UNIFI_OPENER: Any = None
_UNIFI_SIGNATURE: tuple[str, str, str] | None = None


class RejectRedirects(HTTPRedirectHandler):
    # Never forward a bearer token beyond the configured host. A redirect
    # surfaces as an HTTPError instead of being followed.
    def redirect_request(self, request: Request, file_pointer: Any, code: int, message: str, headers: Any, new_url: str) -> None:
        return None


_INVENTORY_OPENER = build_opener(HTTPSHandler(), RejectRedirects())
_HOME_ASSISTANT_OPENER = build_opener(RejectRedirects())
_VIDEO_OPENER = build_opener()


def load_config() -> dict[str, str] | None:
    try:
        value = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    url = str(value.get("url", "")).rstrip("/")
    token = str(value.get("token", ""))
    return {"url": url, "token": token} if url and token else None


def load_unifi_config() -> dict[str, str] | None:
    try:
        value = json.loads(UNIFI_CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    config = {
        "url": str(value.get("url", "")).rstrip("/"),
        "username": str(value.get("username", "")),
        "password": str(value.get("password", "")),
        "site": str(value.get("site", "default")),
    }
    return config if all(config.values()) else None


def load_inventory_config() -> dict[str, str] | None:
    try:
        value = json.loads(INVENTORY_CONFIG_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    if not isinstance(value, dict):
        return None
    config = {
        "url": str(value.get("url", "")).rstrip("/"),
        "token": str(value.get("token", "")),
    }
    parsed = urlparse(config["url"])
    try:
        port = parsed.port
    except ValueError:
        return None
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or not parsed.hostname.lower().endswith(".convex.site")
        or parsed.username
        or parsed.password
        or port not in {None, 443}
        or parsed.path not in {"", "/"}
        or parsed.query
        or parsed.fragment
        or len(config["token"]) < 32
    ):
        return None
    return config


def inventory_request(config: dict[str, str], cursor: str | None) -> Any:
    query = f"?{urlencode({'cursor': cursor})}" if cursor else ""
    request = Request(
        f"{config['url']}/kiosk-inventory{query}",
        headers={"Authorization": f"Bearer {config['token']}"},
    )
    with _INVENTORY_OPENER.open(request, timeout=12) as response:
        return json.loads(response.read())


def validate_url(value: str) -> str:
    url = value.strip().rstrip("/")
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError("Enter a valid Home Assistant http or https address")
    return url


def home_assistant_request(config: dict[str, str], path: str, payload: dict[str, Any] | None = None, timeout: float = 8) -> Any:
    body = json.dumps(payload).encode("utf-8") if payload is not None else None
    request = Request(
        f"{config['url']}{path}",
        data=body,
        headers={
            "Authorization": f"Bearer {config['token']}",
            "Content-Type": "application/json",
        },
        method="POST" if body is not None else "GET",
    )
    with _HOME_ASSISTANT_OPENER.open(request, timeout=timeout) as response:
        raw = response.read()
        return json.loads(raw) if raw else None


def unifi_login(config: dict[str, str], context: ssl.SSLContext) -> Any:
    opener = build_opener(HTTPCookieProcessor(CookieJar()), HTTPSHandler(context=context))
    login = Request(
        f"{config['url']}/api/auth/login",
        data=json.dumps({
            "username": config["username"],
            "password": config["password"],
            "remember": True,
        }).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with opener.open(login, timeout=8) as response:
        response.read()
    return opener


def unifi_status(config: dict[str, str]) -> dict[str, Any]:
    global _UNIFI_OPENER, _UNIFI_SIGNATURE
    parsed = urlparse(config["url"])
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError("Invalid UniFi controller address")

    # The local UniFi console uses its own certificate. Credentials and all
    # requests stay on the LAN, and the account is restricted to Network view-only.
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    signature = (config["url"], config["username"], config["password"])
    site = re.sub(r"[^a-zA-Z0-9_-]", "", config["site"])

    def fetch(opener: Any) -> tuple[list[Any], list[Any]]:
        with opener.open(f"{config['url']}/proxy/network/api/s/{site}/stat/sta", timeout=8) as response:
            clients = json.loads(response.read()).get("data", [])
        with opener.open(f"{config['url']}/proxy/network/api/s/{site}/stat/health", timeout=8) as response:
            health = json.loads(response.read()).get("data", [])
        return clients, health

    def login() -> Any:
        global _UNIFI_OPENER, _UNIFI_SIGNATURE
        # Log in outside the lock. Two concurrent logins are harmless; a slow
        # controller must not queue every other request behind it.
        opener = unifi_login(config, context)
        with _UNIFI_LOCK:
            _UNIFI_OPENER, _UNIFI_SIGNATURE = opener, signature
        return opener

    with _UNIFI_LOCK:
        opener = _UNIFI_OPENER if _UNIFI_SIGNATURE == signature else None
    if opener is None:
        opener = login()
    try:
        clients, health = fetch(opener)
    except HTTPError as error:
        if error.code not in {401, 403}:
            raise
        # UniFi sessions expire. Re-authenticate once, then let any second
        # failure surface as an offline state to the dashboard.
        clients, health = fetch(login())

    wan = next((row for row in health if row.get("subsystem") == "wan"), {})
    public_clients = []
    for client in clients:
        name = client.get("name") or client.get("hostname") or client.get("ip") or "Unknown device"
        public_clients.append({
            "name": str(name),
            "ip": client.get("ip"),
            "network": client.get("essid") or client.get("network") or "Wired",
            "isWired": bool(client.get("is_wired")),
            "signal": client.get("signal"),
            "satisfaction": client.get("satisfaction"),
            "downloadBps": float(client.get("rx_bytes-r") or 0),
            "uploadBps": float(client.get("tx_bytes-r") or 0),
        })
    return {
        "configured": True,
        "connected": True,
        "online": len(public_clients),
        "downloadBps": float(wan.get("rx_bytes-r") or 0),
        "uploadBps": float(wan.get("tx_bytes-r") or 0),
        "clients": public_clients,
    }


def public_entity(entity: dict[str, Any]) -> dict[str, Any]:
    entity_id = str(entity.get("entity_id", ""))
    attributes = entity.get("attributes") if isinstance(entity.get("attributes"), dict) else {}
    return {
        "entityId": entity_id,
        "domain": entity_id.partition(".")[0],
        "name": attributes.get("friendly_name") or entity_id.partition(".")[2].replace("_", " ").title(),
        "state": str(entity.get("state", "unknown")),
        "lastChanged": entity.get("last_changed"),
        "attributes": {
            key: attributes[key]
            for key in (
                "device_class",
                "unit_of_measurement",
                "brightness",
                "temperature",
                "current_temperature",
                "hvac_action",
                "latitude",
                "longitude",
                "gps_accuracy",
            )
            if key in attributes
        },
    }


# Solar comes from the Solis inverter through Home Assistant's ha-solarman
# integration. The grid sensor follows the Solis meter: positive means export.
SOLAR_ZONE = ZoneInfo("Australia/Perth")
SOLAR_STEP = timedelta(minutes=5)
SOLAR_HISTORY_TTL = 60
SOLAR_ENTITIES = {
    "solar": "sensor.solis_load_power",
    "house": "sensor.solis_house_load_power",
    "grid": "sensor.solis_grid_power",
    "pv": "sensor.solis_pv_power",
    "imported": "sensor.solis_total_grid_import",
    "exported": "sensor.solis_total_grid_export",
    "status": "sensor.solis_inverter_status",
    "temperature": "sensor.solis_inverter_temperature",
    # Forecast.Solar's modelled output for the 8 kWp array right now. The
    # system is zero export with no battery, so actual solar is capped at what
    # the house uses. The gap between the two is sun going unused.
    "possible": "sensor.power_production_now",
}
# Forecast.Solar's estimates for the day. Missing entities read as null.
SOLAR_FORECAST_ENTITIES = {
    "todayKwh": "sensor.energy_production_today",
    "remainingKwh": "sensor.energy_production_today_remaining",
    "tomorrowKwh": "sensor.energy_production_tomorrow",
}
SOLAR_FORECAST_PEAK = "sensor.power_highest_peak_time_today"
SOLAR_SERIES = ("solar", "house", "grid")
SOLAR_TOTALS = ("imported", "exported")
SOLAR_HISTORY = (*SOLAR_SERIES, "possible", *SOLAR_TOTALS)


def kilo_divisor(state: dict[str, Any], default: int = 1) -> int:
    """1000 for a sensor reporting W or Wh, 1 for kW or kWh, `default` if it says neither."""
    attributes = state.get("attributes") if isinstance(state.get("attributes"), dict) else {}
    unit = attributes.get("unit_of_measurement")
    if unit in {"W", "Wh"}:
        return 1000
    return 1 if unit in {"kW", "kWh"} else default


def in_kilo(state: dict[str, Any]) -> float | None:
    """A power or energy reading in kW or kWh, whatever unit Home Assistant uses."""
    value = number(state.get("state"))
    return round(value / kilo_divisor(state), 3) if value is not None else None


_SOLAR_LOCK = Lock()
_SOLAR_CACHE: dict[str, Any] = {"key": None, "points": {}, "fetched_at": 0.0, "fetched_until": None}


def number(value: Any) -> float | None:
    try:
        result = float(value)
    except (TypeError, ValueError):
        return None
    return result if result == result else None


def parse_time(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


# A None value marks "unknown"/"unavailable" so an outage ends the previous
# reading instead of stretching it across the gap.
Points = list[tuple[float, float | None]]


# /api/states is about 180 KB and answers in well under 100 ms on the LAN.
# 5 s leaves room for a busy Home Assistant without letting the kiosk hang.
SOLAR_STATES_TIMEOUT = 5
SOLAR_HISTORY_TIMEOUT = 6


def solar_history(config: dict[str, str], start: datetime, end: datetime) -> dict[str, Points]:
    ids = [SOLAR_ENTITIES[key] for key in SOLAR_HISTORY]
    query = urlencode({
        "filter_entity_id": ",".join(ids),
        "end_time": end.isoformat(),
        "minimal_response": "",
        "no_attributes": "",
    })
    result = home_assistant_request(config, f"/api/history/period/{start.isoformat()}?{query}", timeout=SOLAR_HISTORY_TIMEOUT)
    keys = {entity: key for key, entity in SOLAR_ENTITIES.items()}
    points: dict[str, Points] = {}
    for rows in result or []:
        if not rows:
            continue
        key = keys.get(rows[0].get("entity_id", ""))
        if not key:
            continue
        series = points.setdefault(key, [])
        for row in rows:
            value = number(row.get("state", row.get("s")))
            stamp = row.get("last_changed") or row.get("lc") or row.get("last_updated") or row.get("lu")
            if stamp is None:
                continue
            seconds = float(stamp) if isinstance(stamp, (int, float)) else parse_time(stamp).timestamp()
            series.append((seconds, value))
    return points


def refresh_solar_history(config: dict[str, str], now: datetime) -> dict[str, Points]:
    """Keep today's change points, fetching only what changed since the last call.

    The Home Assistant request happens outside the lock so a slow response
    never queues up other requests behind it.
    """
    day = now.astimezone(SOLAR_ZONE).date()
    # A new day or a different Home Assistant server starts a fresh history.
    key = (day, config["url"])
    with _SOLAR_LOCK:
        cache = dict(_SOLAR_CACHE)
    if cache["key"] != key:
        midnight = datetime.combine(day, datetime.min.time(), SOLAR_ZONE)
        points = solar_history(config, midnight, now)
        with _SOLAR_LOCK:
            _SOLAR_CACHE.update(key=key, points=points, fetched_at=time.monotonic(), fetched_until=now)
    elif time.monotonic() - cache["fetched_at"] >= SOLAR_HISTORY_TTL:
        fresh = solar_history(config, cache["fetched_until"], now)
        with _SOLAR_LOCK:
            if _SOLAR_CACHE["key"] == key:
                for name, rows in fresh.items():
                    series = _SOLAR_CACHE["points"].setdefault(name, [])
                    last = series[-1][0] if series else 0
                    series.extend(row for row in rows if row[0] > last)
                _SOLAR_CACHE.update(fetched_at=time.monotonic(), fetched_until=now)
    with _SOLAR_LOCK:
        return {name: list(rows) for name, rows in _SOLAR_CACHE["points"].items()}


def bucket_averages(points: Points, start: float, end: float, step: float) -> list[float | None]:
    """Time-weighted averages. HA only records changes, so each value holds until the next one."""
    count = max(0, int((end - start) // step) + 1)
    totals = [0.0] * count
    covered = [0.0] * count
    for index, (stamp, value) in enumerate(points):
        if value is None:
            continue
        until = points[index + 1][0] if index + 1 < len(points) else end
        begin, finish = max(stamp, start), min(until, end)
        while begin < finish:
            bucket = int((begin - start) // step)
            edge = min(finish, start + (bucket + 1) * step)
            totals[bucket] += value * (edge - begin)
            covered[bucket] += edge - begin
            begin = edge
    return [round(totals[i] / covered[i], 3) if covered[i] else None for i in range(count)]


def integrate_kwh(points: Points, start: float, end: float) -> float:
    total = 0.0
    for index, (stamp, value) in enumerate(points):
        if value is None:
            continue
        until = points[index + 1][0] if index + 1 < len(points) else end
        total += value * max(0.0, min(until, end) - max(stamp, start))
    return total / 3600


def solar_status(config: dict[str, str]) -> dict[str, Any]:
    now = datetime.now(timezone.utc)
    # One request for every state, filtered here, instead of one per sensor.
    by_id = {
        entity.get("entity_id"): entity
        for entity in home_assistant_request(config, "/api/states", timeout=SOLAR_STATES_TIMEOUT) or []
        if isinstance(entity, dict)
    }
    states = {key: by_id.get(entity) or {} for key, entity in SOLAR_ENTITIES.items()}
    value = {key: number(state.get("state")) for key, state in states.items()}
    points = refresh_solar_history(config, now)
    midnight = datetime.combine(now.astimezone(SOLAR_ZONE).date(), datetime.min.time(), SOLAR_ZONE)

    def since_midnight(key: str) -> float | None:
        first = next((row[1] for row in points.get(key, []) if row[1] is not None), None)
        current = value[key]
        return round(max(0.0, current - first), 2) if first is not None and current is not None else None

    series = {
        key: bucket_averages(points.get(key, []), midnight.timestamp(), now.timestamp(), SOLAR_STEP.total_seconds())
        for key in (*SOLAR_SERIES, "possible")
    }
    # History comes back in the sensor's own unit, which is W for the forecast.
    # Forecast.Solar reports W. Keep that if the sensor is briefly missing, so
    # cached history isn't shown 1000 times too big.
    possible_divisor = kilo_divisor(states["possible"], default=1000)
    forecast_states = {key: by_id.get(entity) or {} for key, entity in SOLAR_FORECAST_ENTITIES.items()}
    peak_forecast = (by_id.get(SOLAR_FORECAST_PEAK) or {}).get("state")
    # The inverter keeps its clock (and its "today" counter) in UTC, which
    # resets at 8am in Perth. Integrate the power history instead.
    solar_points = points.get("solar", [])
    generated = round(integrate_kwh(solar_points, midnight.timestamp(), now.timestamp()), 2) if any(row[1] is not None for row in solar_points) else None
    imported, exported = since_midnight("imported"), since_midnight("exported")
    consumed = round(generated + imported - exported, 2) if None not in (generated, imported, exported) else None
    peak = max(((row[1], row[0]) for row in solar_points if row[1] is not None), default=None)
    grid = value["grid"]
    return {
        "configured": True,
        "connected": True,
        # last_reported moves on every poll even when the value is unchanged, so
        # it shows whether the integration is still alive.
        # The forecast is a model, not the inverter, so it can't vouch for freshness.
        "updatedAt": max((state.get("last_reported") or state.get("last_updated", "") for key, state in states.items() if key != "possible"), default=None) or None,
        "status": states["status"].get("state"),
        "now": {
            "solarKw": value["solar"],
            "houseKw": value["house"],
            # The UI treats positive grid power as buying from the grid.
            "gridKw": -grid if grid is not None else None,
            "pvKw": value["pv"],
            "temperatureC": value["temperature"],
        },
        "today": {
            "generatedKwh": generated,
            "consumedKwh": consumed,
            "importedKwh": imported,
            "exportedKwh": exported,
            "selfPoweredPct": round(100 * (1 - imported / consumed)) if consumed and imported is not None else None,
            "peakSolarKw": peak[0] if peak else None,
            "peakSolarAt": datetime.fromtimestamp(peak[1], timezone.utc).isoformat() if peak else None,
        },
        "series": {
            "start": midnight.isoformat(),
            "stepMinutes": int(SOLAR_STEP.total_seconds() // 60),
            "solar": series["solar"],
            "house": series["house"],
            "grid": [-point if point is not None else None for point in series["grid"]],
            "possible": [round(point / possible_divisor, 3) if point is not None else None for point in series["possible"]],
        },
        # Forecast.Solar estimates. Each is null if its sensor is missing.
        "forecast": {
            "potentialKw": in_kilo(states["possible"]),
            **{key: in_kilo(state) for key, state in forecast_states.items()},
            "peakAt": peak_forecast if peak_forecast not in {None, "unknown", "unavailable"} else None,
        },
    }


def sun_status(config: dict[str, str]) -> dict[str, Any]:
    """Sunrise and sunset from Home Assistant's sun.sun, for the evening dimming."""
    state = home_assistant_request(config, "/api/states/sun.sun", timeout=SOLAR_STATES_TIMEOUT)
    if not isinstance(state, dict):
        raise ValueError("Home Assistant sent an unexpected sun state")
    attributes = state.get("attributes") if isinstance(state.get("attributes"), dict) else {}
    return {
        "configured": True,
        "state": state.get("state"),
        "elevation": number(attributes.get("elevation")),
        "rising": attributes.get("rising") is True,
        "nextRising": attributes.get("next_rising"),
        "nextSetting": attributes.get("next_setting"),
    }


VIDEO_RETRY_SECONDS = 60
_VIDEO_LOCK = Lock()
_HEARTBEAT_LOCK = Lock()
_VIDEO_DOWN_UNTIL = 0.0
IMMUTABLE_CACHE = "public, max-age=31536000, immutable"


def video_unavailable_for() -> float:
    with _VIDEO_LOCK:
        return _VIDEO_DOWN_UNTIL - time.monotonic()


def mark_video_unavailable() -> bool:
    """Open the circuit. Returns True when this call opened it, so only the first failure logs."""
    global _VIDEO_DOWN_UNTIL
    with _VIDEO_LOCK:
        now = time.monotonic()
        opened = _VIDEO_DOWN_UNTIL <= now
        _VIDEO_DOWN_UNTIL = now + VIDEO_RETRY_SECONDS
        return opened


def write_heartbeat() -> None:
    clock = getattr(time, "CLOCK_BOOTTIME", time.CLOCK_MONOTONIC)
    temporary = HEARTBEAT_PATH.with_suffix(".new")
    # Two pings at once would otherwise share the temporary file.
    with _HEARTBEAT_LOCK:
        temporary.write_text(f"{time.clock_gettime(clock):.0f}\n", encoding="utf-8")
        temporary.replace(HEARTBEAT_PATH)


class CannvasHandler(SimpleHTTPRequestHandler):
    server_version = "Cannvas"
    sys_version = ""

    def __init__(self, *args: Any, **kwargs: Any) -> None:
        self.cache_control: str | None = None
        self.quiet = False
        super().__init__(*args, directory=str(WEB_ROOT), **kwargs)

    # Static files -----------------------------------------------------------

    def end_headers(self) -> None:
        if self.cache_control:
            self.send_header("Cache-Control", self.cache_control)
        super().end_headers()

    def list_directory(self, path: str | os.PathLike[str]) -> None:
        self.send_error(404)
        return None

    def serve_static(self, path: str, include_body: bool) -> None:
        # Vite puts content hashes in /assets/ file names, so those never change.
        # Everything else, including index.html, must be revalidated.
        self.cache_control = IMMUTABLE_CACHE if path.startswith("/assets/") else "no-cache"
        if include_body:
            super().do_GET()
        else:
            super().do_HEAD()

    # Request checks ---------------------------------------------------------

    def allowed_hosts(self) -> set[str]:
        port = self.server.server_address[1]
        return {f"127.0.0.1:{port}", f"localhost:{port}"}

    def request_is_local(self) -> bool:
        # Chromium on this Pi is the only intended client. Checking Host stops
        # DNS rebinding; checking Origin stops other sites posting to the API.
        hosts = self.allowed_hosts()
        if (self.headers.get("Host") or "").lower() not in hosts:
            return False
        origin = self.headers.get("Origin")
        return origin is None or origin.lower() in {f"http://{host}" for host in hosts}

    def reject_foreign(self) -> bool:
        if self.request_is_local():
            return False
        self.send_plain(403, "Forbidden")
        return True

    # Responses --------------------------------------------------------------

    def send_json(self, status: int, value: Any) -> None:
        body = json.dumps(value).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_plain(self, status: int, message: str = "", headers: dict[str, str] | None = None) -> None:
        body = message.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for name, value in (headers or {}).items():
            self.send_header(name, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def read_json(self) -> dict[str, Any]:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError as error:
            raise ValueError("Invalid request length") from error
        if length <= 0 or length > 64_000:
            raise ValueError("Invalid request body")
        value = json.loads(self.rfile.read(length))
        if not isinstance(value, dict):
            raise ValueError("Expected a JSON object")
        return value

    def home_assistant_error(self, error: Exception) -> None:
        if isinstance(error, HTTPError) and error.code in {401, 403}:
            self.send_json(401, {"error": "Home Assistant rejected the access token"})
        elif isinstance(error, (HTTPError, URLError, TimeoutError)):
            self.send_json(502, {"error": "Home Assistant is unavailable"})
        else:
            self.send_json(500, {"error": "Home Assistant request failed"})

    # Video proxy ------------------------------------------------------------

    def proxy_video(self, include_body: bool = True) -> None:
        # Bruce exposes a video-only, browser-compatible view of PhotoArchive.
        # Keeping that service behind this loopback proxy avoids CORS and keeps
        # the browser isolated from the rest of the home network.
        remaining = video_unavailable_for()
        if remaining > 0:
            # Bruce failed recently. Answer at once instead of letting every
            # video attempt wait for another connection timeout.
            self.quiet = True
            self.send_plain(503, "Bruce video service is unavailable", {"Retry-After": str(int(remaining) + 1)})
            return

        suffix = self.path.removeprefix("/videos") or "/"
        request_headers = {}
        if range_header := self.headers.get("Range"):
            request_headers["Range"] = range_header
        request = Request(f"{VIDEO_URL}{suffix}", headers=request_headers)
        try:
            response = _VIDEO_OPENER.open(request, timeout=20)
        except HTTPError as error:
            # Bruce answered, so it is up. Keep Content-Range so a 416 still
            # tells the browser how long the file is.
            headers = {"Content-Range": value} if (value := error.headers.get("Content-Range")) else {}
            error.close()
            self.send_plain(error.code, "", headers)
            return
        except (URLError, TimeoutError, OSError):
            if mark_video_unavailable():
                self.log_message("Bruce video service is unavailable; answering 503 for %ss", VIDEO_RETRY_SECONDS)
            self.quiet = True
            self.send_plain(502, "Bruce video service is unavailable")
            return

        with response:
            self.send_response(response.status)
            for header in ("Content-Type", "Content-Length", "Content-Range", "Accept-Ranges", "Last-Modified"):
                if value := response.headers.get(header):
                    self.send_header(header, value)
            self.send_header("Cache-Control", "no-store" if suffix.endswith("/") else "private, max-age=3600")
            self.end_headers()
            if not include_body:
                return
            try:
                while chunk := response.read(1024 * 1024):
                    self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError):
                # Chromium drops the connection whenever it seeks or skips a video.
                self.close_connection = True
            except (TimeoutError, OSError):
                # Bruce stalled mid-file. The headers are gone, so just end the response.
                self.close_connection = True

    # Routes -----------------------------------------------------------------

    def get_inventory(self, query: str) -> None:
        config = load_inventory_config()
        if not config:
            self.send_json(200, {"configured": False, "items": []})
            return
        try:
            cursor = parse_qs(query).get("cursor", [None])[0]
            result = inventory_request(config, cursor)
            self.send_json(200, {"configured": True, **result})
        except HTTPError as error:
            if error.code in {401, 403}:
                self.send_json(401, {"error": "Cannvas Inventory access needs attention"})
            else:
                self.send_json(502, {"error": "Cannvas Inventory is temporarily unavailable"})
        except Exception:
            self.send_json(502, {"error": "Cannvas Inventory is temporarily unavailable"})

    def get_unifi_status(self, query: str) -> None:
        config = load_unifi_config()
        if not config:
            self.send_json(200, {"configured": False})
            return
        try:
            self.send_json(200, unifi_status(config))
        except Exception:
            self.send_json(200, {"configured": True, "connected": False})

    def get_solar(self, query: str) -> None:
        config = load_config()
        if not config:
            self.send_json(200, {"configured": False})
            return
        try:
            self.send_json(200, solar_status(config))
        except Exception as error:  # The response deliberately avoids leaking network or token details.
            self.home_assistant_error(error)

    def get_sun(self, query: str) -> None:
        config = load_config()
        if not config:
            self.send_json(200, {"configured": False})
            return
        try:
            self.send_json(200, sun_status(config))
        except Exception as error:  # The response deliberately avoids leaking network or token details.
            self.home_assistant_error(error)

    def get_home_assistant_status(self, query: str) -> None:
        config = load_config()
        if not config:
            self.send_json(200, {"configured": False, "defaultUrl": DEFAULT_URL})
            return
        try:
            ha_config = home_assistant_request(config, "/api/config")
            states = home_assistant_request(config, "/api/states")
            network_config = load_unifi_config()
            try:
                network = unifi_status(network_config) if network_config else {"configured": False}
            except Exception:
                network = {"configured": True, "connected": False}
            self.send_json(200, {
                "configured": True,
                "connected": True,
                "locationName": ha_config.get("location_name", "Home"),
                "version": ha_config.get("version"),
                "url": config["url"],
                "entities": [public_entity(entity) for entity in states if isinstance(entity, dict)],
                "network": network,
            })
        except Exception as error:  # The response deliberately avoids leaking network or token details.
            self.home_assistant_error(error)

    def heartbeat(self, query: str = "") -> None:
        try:
            write_heartbeat()
        except OSError:
            self.send_json(503, {"error": "Heartbeat could not be recorded"})
            return
        self.send_response(204)
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def health(self, query: str = "") -> None:
        # Answers from this process alone, so deploys don't depend on Home Assistant.
        self.send_json(200, {"ok": True})

    def post_poweroff(self) -> None:
        try:
            body = self.read_json()
            if body.get("confirm") != "poweroff":
                raise ValueError("Power-off confirmation is required")

            # Polkit lets the unprivileged kiosk user start only the
            # root-owned Cannvas power-off helper. This remains compatible
            # with NoNewPrivileges=true on the web service.
            subprocess.run(
                ["/usr/bin/systemctl", "start", "cannvas-poweroff.service"],
                check=True,
                timeout=5,
            )
            self.send_json(202, {"ok": True})
        except ValueError as error:
            self.send_json(400, {"error": str(error)})
        except (OSError, subprocess.SubprocessError):
            self.send_json(500, {"error": "Cannvas could not power off"})

    def post_home_assistant_config(self) -> None:
        try:
            body = self.read_json()
            config = {"url": validate_url(str(body.get("url", ""))), "token": str(body.get("token", "")).strip()}
            if len(config["token"]) < 20:
                raise ValueError("Enter a valid long-lived access token")
            # Validate before replacing the last working configuration.
            home_assistant_request(config, "/api/")
            CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
            temporary = CONFIG_PATH.with_suffix(".new")
            temporary.write_text(json.dumps(config), encoding="utf-8")
            os.chmod(temporary, 0o600)
            temporary.replace(CONFIG_PATH)
            self.send_json(200, {"configured": True})
        except ValueError as error:
            self.send_json(400, {"error": str(error)})
        except Exception as error:
            self.home_assistant_error(error)

    def post_home_assistant_action(self) -> None:
        config = load_config()
        if not config:
            self.send_json(409, {"error": "Home Assistant is not connected"})
            return
        try:
            body = self.read_json()
            entity_id = str(body.get("entityId", ""))
            action = str(body.get("action", ""))
            domain = entity_id.partition(".")[0]
            if not ENTITY_ID.fullmatch(entity_id) or action not in ALLOWED_ACTIONS or domain not in ALLOWED_ACTIONS[action]:
                raise ValueError("That Home Assistant action is not allowed")
            result = home_assistant_request(config, f"/api/services/{domain}/{action}", {"entity_id": entity_id})
            self.send_json(200, {"ok": True, "states": [public_entity(entity) for entity in result or []]})
        except ValueError as error:
            self.send_json(400, {"error": str(error)})
        except Exception as error:
            self.home_assistant_error(error)

    def post_heartbeat(self) -> None:
        self.heartbeat()

    GET_ROUTES = {
        "/api/inventory": get_inventory,
        "/api/unifi/status": get_unifi_status,
        "/api/solar": get_solar,
        "/api/sun": get_sun,
        "/api/home-assistant/status": get_home_assistant_status,
        "/api/heartbeat": heartbeat,
        "/api/health": health,
    }
    POST_ROUTES = {
        "/api/system/poweroff": post_poweroff,
        "/api/home-assistant/config": post_home_assistant_config,
        "/api/home-assistant/action": post_home_assistant_action,
        "/api/heartbeat": post_heartbeat,
    }

    def do_GET(self) -> None:
        if self.reject_foreign():
            return
        parsed = urlparse(self.path)
        if parsed.path == "/videos" or parsed.path.startswith("/videos/"):
            self.proxy_video()
        elif route := self.GET_ROUTES.get(parsed.path):
            route(self, parsed.query)
        elif parsed.path == "/api" or parsed.path.startswith("/api/"):
            self.send_json(404, {"error": "Not found"})
        else:
            self.serve_static(parsed.path, include_body=True)

    def do_HEAD(self) -> None:
        if self.reject_foreign():
            return
        parsed = urlparse(self.path)
        if parsed.path == "/videos" or parsed.path.startswith("/videos/"):
            self.proxy_video(include_body=False)
        elif parsed.path == "/api" or parsed.path.startswith("/api/"):
            self.send_plain(405, "")
        else:
            self.serve_static(parsed.path, include_body=False)

    def do_POST(self) -> None:
        if self.reject_foreign():
            return
        # Browsers cannot send application/json cross-origin without a CORS
        # preflight, which this server never approves.
        if self.headers.get("Content-Type", "").partition(";")[0].strip().lower() != "application/json":
            self.send_json(415, {"error": "Expected a JSON request"})
            return
        route = self.POST_ROUTES.get(urlparse(self.path).path)
        if route:
            route(self)
        else:
            self.send_json(404, {"error": "Not found"})

    # Logging ----------------------------------------------------------------

    def log_request(self, code: int | str = "-", size: int | str = "-") -> None:
        # Successful requests are routine. Only failures reach the journal.
        if self.quiet:
            return
        try:
            status = int(code)
        except (TypeError, ValueError):
            status = 0
        if 200 <= status < 300 or status == 304:
            return
        super().log_request(code, size)

    def log_message(self, format: str, *args: object) -> None:
        print(f"cannvas server: {format % args}", flush=True)


class CannvasServer(ThreadingHTTPServer):
    daemon_threads = True

    def handle_error(self, request: Any, client_address: Any) -> None:
        # Clients hang up mid-response all the time (video seeks, reloads).
        if isinstance(sys.exc_info()[1], (BrokenPipeError, ConnectionResetError, TimeoutError)):
            return
        super().handle_error(request, client_address)


def main() -> None:
    CannvasServer((LISTEN_HOST, LISTEN_PORT), CannvasHandler).serve_forever()


if __name__ == "__main__":
    main()
