#!/usr/bin/python3
"""Serve Cannvas and proxy its private local integrations.

The browser only talks to this loopback server. Home Assistant and Inventory
credentials stay in mode-0600 files on the Pi instead of being compiled
into the public JavaScript bundle.
"""

from __future__ import annotations

from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from http.cookiejar import CookieJar
import json
import os
