#!/bin/sh
set -u

cec_client=/usr/bin/cec-client
edid_path=/sys/class/drm/card1-HDMI-A-1/edid
attempt=1

log() {
  printf '%s %s\n' "$(/usr/bin/date --iso-8601=seconds)" "$*"
}

# HDMI remains "connected" while this TV is in standby, so it cannot prove that
# the panel woke. libCEC can register a playback address before the TV exposes
# its EDID, unlike separate cec-ctl invocations which transmit as unregistered.
# A non-empty EDID is the reliable signal that this television is awake.
if [ ! -x "$cec_client" ]; then
  log "cec-client is unavailable; install the cec-utils package"
  exit 0
fi

while [ "$attempt" -le 12 ]; do
  log "CEC wake attempt $attempt of 12"

  if cec_output=$(printf 'on 0\nas\n' | "$cec_client" -s -d 8 2>&1); then
    log "Sent IMAGE_VIEW_ON and ACTIVE_SOURCE through cec-client"
  else
    log "cec-client failed: $(printf '%s\n' "$cec_output" | /usr/bin/tail -n 1)"
  fi

  edid_bytes=0
  if [ -r "$edid_path" ]; then
    edid_bytes=$(/usr/bin/wc -c < "$edid_path")
  fi
  if [ "$edid_bytes" -gt 0 ]; then
    log "TV EDID is available ($edid_bytes bytes); display is awake"
    exit 0
  fi

  attempt=$((attempt + 1))
  if [ "$attempt" -le 12 ]; then
    sleep 5
  fi
done

log "TV EDID remained unavailable after 12 CEC wake attempts"
exit 0
