#!/bin/sh
set -eu

app_url=http://127.0.0.1:4173
connector_status=/sys/class/drm/card1-HDMI-A-1/status
display_output=HDMI-A-1

# Chromium can restore the prior app window from its long-lived kiosk profile
# without navigating to the current release. A unique query value forces a real
# page load each time the kiosk starts. Vite's hashed assets remain cacheable.
launch_url="${app_url}/?kiosk_launch=$(/usr/bin/date +%s)"

# Labwc creates a temporary headless output when it starts before the TV. If
# Chromium launches on that output, it can stay invisible after HDMI connects.
# Wait for the real portrait display so the kiosk lands on HDMI-A-1.
while [ -r "$connector_status" ] && [ "$(/usr/bin/cat "$connector_status")" != connected ]; do
  sleep 1
done

# CEC wake changes the output from a landscape fallback mode to the TV's real
# EDID. Apply the physical portrait transform before Chromium chooses its window
# geometry, otherwise the 1080x1920 app remains centred on a 1920x1080 desktop.
transform_attempt=1
while [ "$transform_attempt" -le 10 ]; do
  if /usr/bin/wlr-randr \
    --output "$display_output" \
    --mode 1920x1080@60Hz \
    --transform 90 \
    >/tmp/cannvas-display-transform.log 2>&1; then
    break
  fi
  transform_attempt=$((transform_attempt + 1))
  sleep 1
done

# The desktop can start a little before the web service. Avoid showing Chromium's
# connection error page by waiting for Cannvas to answer first.
until /usr/bin/curl --fail --silent --output /dev/null "$app_url"; do
  sleep 1
done

# PipeWire cannot use the vc4 HDMI card's raw PCM format. Its user config tries
# to create a converted cannvas_hdmi sink through ALSA's hdmi plugin. On a cold
# boot the TV can appear after PipeWire starts, so retry loading the module here
# as well. Select it before Chromium starts so video streams use the TV speakers.
audio_attempt=1
audio_ready=0
while [ "$audio_attempt" -le 20 ]; do
  if /usr/bin/pactl set-default-sink cannvas_hdmi >/dev/null 2>&1; then
    audio_ready=1
    break
  fi

  # Loading an already-present sink fails harmlessly. This recovers the more
  # important case where PipeWire's startup load ran before HDMI was ready.
  /usr/bin/pactl load-module module-alsa-sink \
    device=hdmi:0 \
    sink_name=cannvas_hdmi \
    format=s16le \
    rate=48000 \
    channels=2 \
    sink_properties=api.alsa.card=0 \
    >/tmp/cannvas-audio-setup.log 2>&1 || true

  audio_attempt=$((audio_attempt + 1))
  sleep 0.25
done

if [ "$audio_ready" -ne 1 ]; then
  echo "Cannvas: could not create or select the cannvas_hdmi audio sink" >&2
fi

# A true fullscreen Labwc window is rendered above Squeekboard, which hides the
# touch keyboard. Use a borderless, screen-sized app window instead. The Labwc
# rule in deploy/labwc-rc.xml removes its decoration.
panel_respawner=$(/usr/bin/pgrep -f '^/bin/sh /usr/bin/lwrespawn /usr/bin/wf-panel-pi$' || true)
if [ -n "$panel_respawner" ]; then
  /usr/bin/kill "$panel_respawner"
fi
/usr/bin/pkill -x wf-panel-pi || true

exec /usr/bin/chromium \
  --app="$launch_url" \
  --window-position=0,0 \
  --window-size=1080,1920 \
  --force-device-scale-factor=1 \
  --ozone-platform=wayland \
  --touch-events=enabled \
  --lang=en-AU \
  --no-first-run \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=TranslateUI \
  --overscroll-history-navigation=0 \
  --password-store=basic
