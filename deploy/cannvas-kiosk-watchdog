#!/bin/sh
set -eu

# Restart Chromium when the Cannvas page stops pinging /api/heartbeat.
# cannvas-server stores the boot-clock second of the latest ping. Using the
# boot clock keeps NTP jumps after boot from looking like a frozen page.
heartbeat=${CANNVAS_HEARTBEAT_PATH:-/run/cannvas/heartbeat}
stale_after=${CANNVAS_HEARTBEAT_STALE:-180}
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/cannvas-kiosk-watchdog"

if [ -r "$heartbeat" ]; then
  last=$(cut -d. -f1 "$heartbeat")
  now=$(cut -d. -f1 /proc/uptime)
  age=$((now - last))
  if [ "$age" -le "$stale_after" ]; then
    rm -f "$state"
    exit 0
  fi
  silence=$last
  reason="has not pinged for ${age}s"
else
  # No ping since boot. On 12 and 13 Nov 2026 Chromium's network service
  # crashed a second after the kiosk opened the page, which left a blank white
  # window that never loaded the app, so it never pinged. Treat that like any
  # other silence, but only once Chromium itself is running (the kiosk script
  # waits for the TV and the server first) and has had the grace period.
  silence=never
  reason="has never pinged since boot"
fi

# If the web server itself is down, a new Chromium would not help.
/usr/bin/curl --fail --silent --output /dev/null --max-time 5 http://127.0.0.1:4173/ || exit 0

# Leave a kiosk that is stopped (systemd restarts it) or still starting alone.
[ "$(/usr/bin/systemctl --user is-active cannvas-kiosk.service)" = active ] || exit 0
# systemd records this on CLOCK_MONOTONIC, so compare it with that clock.
started=$(/usr/bin/systemctl --user show cannvas-kiosk.service -p ActiveEnterTimestampMonotonic --value)
monotonic=$(/usr/bin/python3 -c 'import time; print(int(time.clock_gettime(time.CLOCK_MONOTONIC)))')
if [ $((monotonic - started / 1000000)) -le "$stale_after" ]; then
  exit 0
fi
if [ "$silence" = never ]; then
  # cannvas-kiosk execs Chromium, so the main PID only becomes chromium once
  # its waits for the TV and the server are over. It notes the boot-clock
  # second just before that exec; time the grace from there.
  pid=$(/usr/bin/systemctl --user show cannvas-kiosk.service -p MainPID --value)
  [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = chromium ] || exit 0
  launched_file="$(dirname "$state")/cannvas-kiosk-launched"
  [ -r "$launched_file" ] || exit 0
  now=$(cut -d. -f1 /proc/uptime)
  [ $((now - $(cut -d. -f1 "$launched_file"))) -gt "$stale_after" ] || exit 0
fi

# Restart once per silence. If the page never pings again after a restart,
# the problem is not Chromium, and looping would only hide it.
if [ -r "$state" ] && [ "$(cat "$state")" = "$silence" ]; then
  exit 0
fi
# <4> marks the line as a warning so it passes the unit's LogLevelMax.
echo "<4>Cannvas page ${reason}; restarting the kiosk"
# Record the silence only once the restart is queued, so a failed request is
# retried. --no-block returns once queued: a slow Chromium stop could outlast
# this unit's 30 s timeout, kill us before the record, and repeat the restart.
/usr/bin/systemctl --user --no-block restart cannvas-kiosk.service
echo "$silence" >"$state"
